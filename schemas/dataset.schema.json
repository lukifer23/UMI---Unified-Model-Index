        "benchmark_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benchmark Version"
        },
        "cohort_key": {
          "default": "unspecified",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Cohort Key",
          "type": "string"
        },
        "confidence_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Interval"
        },
        "configuration_verified": {
          "anyOf": [

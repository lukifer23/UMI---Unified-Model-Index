      "minimum": 1,
      "title": "Configured Timeout Seconds",
      "type": "integer"
    },
    "final_trial_row_count": {
      "minimum": 1,
      "title": "Final Trial Row Count",
      "type": "integer"
    },
    "full_cohort_model_count": {
      "minimum": 8,
      "title": "Full Cohort Model Count",
      "type": "integer"
    },
    "headline_eligible": {
      "title": "Headline Eligible",
      "type": "boolean"
    },
    "headline_overall": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,

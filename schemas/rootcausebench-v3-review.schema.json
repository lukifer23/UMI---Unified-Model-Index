  "required": [
    "report_version",
    "source_url",
    "source_commit",
    "source_artifact_ids",
    "source_artifact_sha256",
    "license_id",
    "redistribution_scope",
    "final_trial_row_count",
    "full_cohort_model_count",
    "anchor_cohort_sufficient",
    "configured_attempts_per_task",
    "configured_timeout_seconds",
    "models",
    "scoring_disposition",
    "headline_eligible",
    "blockers",
    "review_fingerprint"
  ],
  "title": "RootCauseBenchReview",
  "type": "object"
}

    "license_id": {
      "title": "License Id",
      "type": "string"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/RootCauseBenchModelReview"
      },
      "title": "Models",
      "type": "array"
    },
    "redistribution_scope": {
      "title": "Redistribution Scope",
      "type": "string"
    },
    "report_version": {
      "title": "Report Version",
      "type": "string"
    },
    "review_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Fingerprint",
      "type": "string"
    },
    "scoring_disposition": {
      "title": "Scoring Disposition",
      "type": "string"
    },
    "source_artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Artifact Ids",
      "type": "array"
    },
    "source_artifact_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Artifact Sha256",
      "type": "object"
    },
    "source_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Source Commit",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    }

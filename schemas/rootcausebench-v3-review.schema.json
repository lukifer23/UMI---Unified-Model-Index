          "minimum": 1,
          "title": "Attempts Per Task",
          "type": "integer"
        },
        "candidate_pilot_id": {
          "title": "Candidate Pilot Id",
          "type": "string"
        },
        "configured_agent": {
          "title": "Configured Agent",
          "type": "string"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "economics_admitted": {
          "title": "Economics Admitted",
          "type": "boolean"
        },
        "efficiency_admitted": {
          "title": "Efficiency Admitted",
          "type": "boolean"
        },
        "exact_pilot_configuration_match": {
          "title": "Exact Pilot Configuration Match",
          "type": "boolean"
        },
        "explicit_inference_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explicit Inference Effort"
        },
        "final_trial_errors": {
          "minimum": 0,
          "title": "Final Trial Errors",
          "type": "integer"
        },
        "mean_graded_reward": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mean Graded Reward",
          "type": "number"
        },
        "pass_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pass Rate",
          "type": "number"
        },
        "resource_observations": {
          "items": {
            "$ref": "#/$defs/ResourceObservationSummary"
          },
          "title": "Resource Observations",
          "type": "array"
        },
        "scoring_disposition": {
          "title": "Scoring Disposition",
          "type": "string"
        },
        "source_model_id": {
          "title": "Source Model Id",
          "type": "string"
        },
        "successful_final_trials": {
          "minimum": 1,
          "title": "Successful Final Trials",
          "type": "integer"
        },
        "task_count": {
          "minimum": 1,
          "title": "Task Count",
          "type": "integer"
        },
        "unique_trial_directories": {
          "minimum": 1,
          "title": "Unique Trial Directories",
          "type": "integer"
        }
      },
      "required": [
        "candidate_pilot_id",
        "source_model_id",
        "configured_agent",
        "attempts",
        "successful_final_trials",
        "pass_rate",
        "mean_graded_reward",
        "task_count",
        "attempts_per_task",
        "unique_trial_directories",
        "final_trial_errors",
        "resource_observations",
        "exact_pilot_configuration_match",
        "efficiency_admitted",
        "economics_admitted",
        "scoring_disposition",
        "diagnostics"
      ],
      "title": "RootCauseBenchModelReview",
      "type": "object"

          "type": "number"
        },
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "minimum": 0,
          "title": "Minimum",
          "type": "number"
        },
        "observation_count": {
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "source_column": {
          "title": "Source Column",
          "type": "string"
        },
        "success_adjusted_mean": {
          "minimum": 0,
          "title": "Success Adjusted Mean",
          "type": "number"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "number"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "source_column",
        "unit",
        "observation_count",
        "total",
        "attempted_mean",
        "success_adjusted_mean",
        "minimum",
        "maximum"
      ],
      "title": "ResourceObservationSummary",
      "type": "object"
